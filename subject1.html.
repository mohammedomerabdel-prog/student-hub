            <p>👨‍🏫 أستاذ المادة: د. [اسم أستاذ المادة]</p>
        </div>
    </section>

    <main class="container">

        <!-- قسم المحاضرات -->
        <section class="content-section">
            <h2 class="section-title">📖 المحاضرات الرسمية</h2>
            <div class="file-list">
                <div class="file-item">
                    <div class="file-info">
                        <span class="file-icon">📄</span>
                        <span class="file-name">المحاضرة 1: مقدمة ومدخل إلى المادة</span>
                    </div>
                    <a href="رابط_الفيلم_من_درابف_هنا" target="_blank" class="download-btn">عرض المحاضرة 👁️</a>
                </div>
                <div class="file-item">
                    <div class="file-info">
                        <span class="file-icon">📄</span>
                        <span class="file-name">المحاضرة 2: المفاهيم الأساسية</span>
                    </div>
                    <a href="رابط_الفيلم_من_درابف_هنا" target="_blank" class="download-btn">عرض المحاضرة 👁️</a>
                </div>
            </div>
        </section>

        <!-- قسم الملخصات -->
        <section class="content-section">
            <h2 class="section-title">📝 الملخصات الشاملة</h2>
            <div class="file-list">
                <div class="file-item">
                    <div class="file-info">
                        <span class="file-icon">📑</span>
                        <span class="file-name">ملخص الشابتر الأول - إعداد الطلاب</span>
                    </div>
                    <a href="رابط_الملخص_من_درايف_هنا" target="_blank" class="download-btn">فتح الملخص 📥</a>
                </div>
            </div>
        </section>

        <!-- قسم المراجعات والأسئلة -->
        <section class="content-section">
            <h2 class="section-title">🔍 المراجعات الشيتات والأسئلة</h2>
            <div class="file-list">
                <div class="file-item">
                    <div class="file-info">
                        <span class="file-icon">❓</span>
                        <span class="file-name">شيت أسئلة ومراجعة لأعمال السنة</span>
                    </div>
                    <a href="رابط_الشيت_من_درايف_هنا" target="_blank" class="download-btn">فتح الشيت 📥</a>
                </div>
            </div>
        </section>

    </main>

    <footer>
        <p>منصة طلاب كلية العلوم الإدارية • دفعة 023</p>
    </footer>

</body>
</html>
